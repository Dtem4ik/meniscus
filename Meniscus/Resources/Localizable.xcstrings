    },
    "The shortcut has no name.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У быстрой команды не указано название."
          }
        }
      }
    },
    "This build of Meniscus was made without its Now Playing component. Build it with CMake installed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка Meniscus сделана без компонента «Сейчас играет». Соберите её с установленным CMake."
          }
        }
      }
    },
    "This config is version %lld; this Meniscus understands up to %lld. Update Meniscus.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это конфигурация версии %lld, а эта версия Meniscus понимает только до %lld. Обновите Meniscus."
          }
        }
      }
    },
    "This version of macOS doesn't let Meniscus read what's playing anymore.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия macOS больше не позволяет Meniscus узнавать, что играет."
          }
        }
      }
    },
    "This version of macOS no longer includes the system component Meniscus uses to read what's playing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
