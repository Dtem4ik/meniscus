          "stringUnit": {
            "state": "translated",
            "value": "Замедленные анимации (×%lld)"
          }
        }
      }
    },
    "Stored in config.json. Edits made in a text editor show up here automatically.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится в config.json. Изменения, сделанные в текстовом редакторе, появляются здесь автоматически."
          }
        }
      }
    },
    "The app has no bundle id.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У приложения не указан bundle ID."
          }
        }
      }
    },
    "The example config is missing from the app bundle.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример конфигурации отсутствует в приложении."
          }
        }
      }
    },
    "The file has no path.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У файла не указан путь."
