{
  "sourceLanguage": "en",
  "strings": {
    "Acknowledgements": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Благодарности"
          }
        }
      }
    },
    "All day": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь день"
          }
        }
      }
    },
    "Allow Calendar Access…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить доступ к календарю…"
          }
        }
      }
    },
    "Built-in display with notch": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенный дисплей с вырезом"
          }
        }
      }
    },
    "Calendar access is requested the first time you open the island with this on.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю запрашивается, когда вы впервые откроете остров с этой настройкой."
          }
        }
      }
    },
    "Charging": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядка"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка…"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировано"
          }
        }
      }
    },
    "Copy Geometry Report": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать отчёт о геометрии"
          }
        }
      }
    },
    "Developer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разработка"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основные"
          }
        }
      }
    },
    "Haptic feedback on the trackpad": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тактильный отклик на трекпаде"
          }
        }
      }
    },
    "License": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лицензия"
          }
        }
      }
    },
    "Main display": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной дисплей"
          }
        }
      }
    },
    "Meniscus": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Meniscus"
          }
        }
      }
    },
    "Next": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий трек"
          }
        }
      }
    },
    "No more events today": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня событий больше нет"
          }
        }
      }
    },
    "Now playing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас играет"
          }
        }
      }
    },
    "Now · until %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас · до %@"
          }
        }
      }
    },
    "Open or Close Island": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть или закрыть остров"
          }
        }
      }
    },
    "Open when the pointer rests on the notch": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать, когда указатель задерживается на вырезе"
          }
        }
      }
    },
    "Other": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие"
          }
        }
      }
    },
    "Outline Computed Notch": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обвести вычисленный вырез"
          }
        }
      }
    },
    "Outline the computed notch in red": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обвести вычисленный вырез красным"
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза"
          }
        }
      }
    },
    "Play": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизвести"
          }
        }
      }
    },
    "Previous": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущий трек"
          }
        }
      }
    },
    "Quit Meniscus": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершить Meniscus"
          }
        }
      }
    },
    "Reading what's playing keeps failing. Meniscus stopped trying until it's relaunched.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся узнать, что играет. Meniscus прекратил попытки до следующего запуска."
          }
        }
      }
    },
    "Reads what's playing on this Mac. BSD 3-Clause License, © Jonas van den Berg and contributors.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнаёт, что играет на этом Mac. Лицензия BSD 3-Clause, © Jonas van den Berg и участники проекта."
          }
        }
      }
    },
    "Screen numbers behind the notch outline. Paste them into a bug report.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметры экрана, по которым строится вырез. Вставьте их в отчёт об ошибке."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки"
          }
        }
      }
    },
    "Settings stay available from the gear button inside the notch.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки остаются доступны по кнопке с шестерёнкой внутри выреза."
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки…"
          }
        }
      }
    },
    "Show Calendar": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать календарь"
          }
        }
      }
    },
    "Show icon in the menu bar": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать значок в строке меню"
          }
        }
      }
    },
    "Show on": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать на"
          }
        }
      }
    },
    "Show the next calendar event": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать ближайшее событие календаря"
          }
        }
      }
    },
    "Show what's playing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать, что играет"
          }
        }
      }
    },
    "Shows what any app is playing, with its artwork and controls.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, что играет в любом приложении, с обложкой и кнопками управления."
          }
        }
      }
    },
    "Shows what any app is playing, with its artwork and controls. Click the app's icon to switch to it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, что играет в любом приложении, с обложкой и кнопками управления. Нажмите на значок приложения, чтобы перейти в него."
          }
        }
      }
    },
    "Simulate Charging": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имитировать зарядку"
          }
        }
      }
    },
    "Slow Animations": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замедленные анимации"
          }
        }
      }
    },
    "Slow animations (×%lld)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замедленные анимации (×%lld)"
          }
        }
      }
    },
    "Sparkle": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блеск"
          }
        }
      }
    },
    "This build of Meniscus was made without its Now Playing component. Build it with CMake installed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка Meniscus сделана без компонента «Сейчас играет». Соберите её с установленным CMake."
          }
        }
      }
    },
    "This version of macOS doesn't let Meniscus read what's playing anymore.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия macOS больше не позволяет Meniscus узнавать, что играет."
          }
        }
      }
    },
    "This version of macOS no longer includes the system component Meniscus uses to read what's playing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии macOS больше нет системного компонента, через который Meniscus узнаёт, что играет."
          }
        }
      }
    },
    "Tuning": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонкая настройка"
          }
        }
      }
    },
    "Use Virtual Notch": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виртуальный вырез"
          }
        }
      }
    },
    "Use a virtual notch on this screen": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать виртуальный вырез на этом экране"
          }
        }
      }
    }
  },
  "version": "1.0"
}
